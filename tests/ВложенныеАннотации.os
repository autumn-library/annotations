#Использовать asserts

&Тест
Процедура ЭтоАннотацияРаспознаетВложеннуюАннотацию() Экспорт

	// Дано
	Метод = НайтиМетод("МетодСВложеннойАннотацией");
	ВнешняяАннотация = РаботаСАннотациями.НайтиАннотацию(Метод.Аннотации, "Внешняя");

	// Когда
	ЗначениеПараметра = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(ВнешняяАннотация, "Значение");

	// Тогда
	Ожидаем.Что(РаботаСАннотациями.ЭтоАннотация(ЗначениеПараметра)).Равно(Истина);
	Ожидаем.Что(РаботаСАннотациями.ЭтоАннотация("просто строка")).Равно(Ложь);
	Ожидаем.Что(РаботаСАннотациями.ЭтоАннотация(Неопределено)).Равно(Ложь);

КонецПроцедуры

&Тест
Процедура СоздатьОбъектАннотацииРекурсивноМатериализуетВложеннуюАннотацию() Экспорт

	// Дано
	Метод = НайтиМетод("МетодСВложеннойАннотацией");
	ВнешняяАннотация = РаботаСАннотациями.НайтиАннотацию(Метод.Аннотации, "Внешняя");
	КонтейнерАннотаций = ПодготовитьКонтейнер();

	// Когда
	ОпределениеВнешней = КонтейнерАннотаций.ПолучитьОпределениеАннотации("Внешняя");
	ОбъектВнешней = ОпределениеВнешней.СоздатьОбъектАннотации(ВнешняяАннотация, КонтейнерАннотаций);

	// Тогда
	Ожидаем.Что(ОбъектВнешней.УстановленноеЗначение).ИмеетТип("АннотацияЦель");
	Ожидаем.Что(ОбъектВнешней.УстановленноеЗначение.УстановленноеЗначение).Равно("вложенное значение");

КонецПроцедуры

&Тест
Процедура БезКонтейнераВложеннаяАннотацияОстаетсяСтрокойТаблицы() Экспорт

	// Дано
	Метод = НайтиМетод("МетодСВложеннойАннотацией");
	ВнешняяАннотация = РаботаСАннотациями.НайтиАннотацию(Метод.Аннотации, "Внешняя");
	КонтейнерАннотаций = ПодготовитьКонтейнер();

	// Когда
	ОпределениеВнешней = КонтейнерАннотаций.ПолучитьОпределениеАннотации("Внешняя");
	ОбъектВнешней = ОпределениеВнешней.СоздатьОбъектАннотации(ВнешняяАннотация);

	// Тогда
	Ожидаем.Что(ОбъектВнешней.УстановленноеЗначение).ИмеетТип("СтрокаТаблицыЗначений");

КонецПроцедуры

Функция ПодготовитьКонтейнер()
	КонтейнерАннотаций = Новый КонтейнерАннотаций();
	КонтейнерАннотаций.ДобавитьАннотацию(Тип("АннотацияВнешняя"));
	КонтейнерАннотаций.ДобавитьАннотацию(Тип("АннотацияЦель"));
	Возврат КонтейнерАннотаций;
КонецФункции

Функция НайтиМетод(ИмяМетода)

	Рефлектор = Новый Рефлектор();
	ТаблицаМетодов = Рефлектор.ПолучитьТаблицуМетодов(Тип("ВладелецВложенныхАннотаций"));
	Возврат ТаблицаМетодов.Найти(ИмяМетода, "Имя");

КонецФункции
